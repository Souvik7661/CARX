# CARX Backend Configuration
PROJECT_NAME="CARX — AI Vehicle Intelligence Platform"
API_V1_STR=/api
SECRET_KEY=carx-super-secret-key-2026-production-grade
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Relational Database: Defaults to SQLite for immediate zero-config execution
# To use PostgreSQL, set:
# DATABASE_URL=postgresql://user:password@localhost:5432/carx_db
DATABASE_URL=sqlite:///./carx.db

# Storage Abstraction Path
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=15

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000/api
